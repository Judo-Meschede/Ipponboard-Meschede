QDialog { background:#050505; color:#f4f4f4; font-family:'Segoe UI'; }
QLabel { background:transparent; }
#cardSingle, #cardTeam, #cardAdmin { background:transparent; border:2px solid transparent; border-radius:18px; }
#cardSingle:hover, #cardAdmin:hover { background:rgba(215,25,30,18); border:2px solid rgba(235,35,40,190); }
#cardTeam:hover { background:rgba(255,255,255,8); border:2px solid rgba(255,65,70,225); }
#label_serverStatus { color:#39df69; font-size:16px; font-weight:700; }
#label_lastUpdate, #label_cacheStatus, #label_info { color:#aeb0b3; font-size:14px; }
#btnSync { color:#ffffff; font-size:13px; font-weight:600; background:rgba(110,16,19,210); border:1px solid rgba(225,48,54,210); border-radius:8px; padding:0 12px; }
#btnSync:hover { background:rgba(155,20,25,225); border-color:rgba(255,72,78,235); }
#btnSync:disabled { color:#b9b9b9; background:rgba(55,55,55,180); border-color:rgba(100,100,100,150); }
#btnSettings, #btnHelp, #btnAbout { background:rgba(0,0,0,0); border:0; }
